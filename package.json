{
  "name": "echora-pwa",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter=@echora/web dev",
    "build": "turbo run build",
    "lint": "pnpm --filter=@echora/web lint",
    "test": "turbo run test",
    "bench": "pnpm --filter=@echora/web bench",
    "check:shell": "node scripts/check-shell-closure.mjs",
    "test:e2e": "pnpm --filter=@echora/web exec playwright test",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "check:api": "tsc --noEmit -p api/tsconfig.json",
    "test:api": "corepack pnpm --filter=@echora/web exec vitest run src/api"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "prettier": "^3.2.5",
    "turbo": "^2.0.0",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@9.0.0"
}
