# Spotify Developer Dashboard → Folia app → Redirect URI
VITE_SPOTIFY_CLIENT_ID=
VITE_SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/

# Optional: Google Cloud YouTube Data API v3 key for public music search.
# YouTube Music personal playback and private playlists are not exposed by the official API.
VITE_YOUTUBE_API_KEY=
