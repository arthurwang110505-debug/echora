# Spotify Developer Dashboard → Folia app → Redirect URI
VITE_SPOTIFY_CLIENT_ID=
VITE_SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/app

# Optional: Google Cloud YouTube Data API v3 key for public music search.
# Server-side only — the browser calls /api/youtube/search, so the key never ships
# to the client. Do not prefix this with VITE_. (Private playlists and playback
# still use the official OAuth Data API; public search uses this key.)
YOUTUBE_API_KEY=

# Agnes AI is server-side only. Do not prefix this with VITE_ or expose it in the browser.
# For Vercel, configure AGNES_API_KEY in Project Settings → Environment Variables.
AGNES_API_KEY=
